# Copy to `.env` for `alchemy dev` and `alchemy deploy`.
#
# The Cloudflare Access application in front of the app (ADR-0011, README
# "Cloudflare Access"). Every API route but /api/health requires a valid
# `Cf-Access-Jwt-Assertion` from this team for this application. Locally the
# Worker is reached on localhost, which is exempt, so placeholders do for
# `alchemy dev`; a deploy needs the real values.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-aud-tag

# The model provider's key is NOT set here: `API_PROVIDER_KEY` lives in
# Infisical (project linked by `.infisical.yaml`). `pnpm dev` runs
# `infisical run --env=dev` and `pnpm deploy` runs `infisical run --env=prod`,
# which put it in the environment for Alchemy to bind as a Worker secret.

# OpenUI telemetry off (ADR-0006).
OPENUI_TELEMETRY_DISABLED=1
