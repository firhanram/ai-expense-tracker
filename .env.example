# Copy to `.env` for `alchemy dev` and `alchemy deploy`.
#
# Deploy only: the one email the Cloudflare Access policy lets in (ADR-0011, README
# "Cloudflare Access"). Kept out of `alchemy.run.ts` because the repository
# is public. The team domain and AUD tag are no longer set here: `alchemy
# deploy` binds them to the Worker from `alchemy.run.ts` and the Access
# application it creates.
ACCESS_OWNER_EMAIL=you@example.com

# The model provider's key is NOT set here: `API_PROVIDER_KEY` lives in
# Infisical (project linked by `.infisical.yaml`). `pnpm dev` runs
# `infisical run --env=dev` and `pnpm run deploy` runs `infisical run --env=prod`,
# which put it in the environment for Alchemy to bind as a Worker secret.

# OpenUI telemetry off (ADR-0006).
OPENUI_TELEMETRY_DISABLED=1
